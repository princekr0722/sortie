# Provider/model, e.g. anthropic/claude-haiku-5-5, openai/gpt-4o, gemini/gemini-2.0-flash, ollama/llama3.1
LLM_MODEL=
# API key for that provider (leave empty for local Ollama)
LLM_API_KEY=
# Optional: custom endpoint (proxy, LM Studio, remote Ollama, OpenAI-compatible server). Empty = provider default
LLM_API_BASE=
# Optional: false = turn off reasoning on open models via OpenAI-compatible APIs (NVIDIA, vLLM). Faster, fewer tokens
LLM_THINKING=
